{
  "manifest_version": 3,
  "name": "Eyes Only",
  "version": "0.3",
  "description": "Lets the Eyes Only menu-bar app protect individual tabs. Reports your windows and tabs to the app on this Mac only; sends nothing over the network.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging", "tabs"],
  "background": { "service_worker": "background.js" },
  "incognito": "spanning"
}
